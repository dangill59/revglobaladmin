@page "/"
@using GlobalAdmin.Services
@inject AnalyticsService Analytics
@rendermode InteractiveServer

<PageTitle>Global Admin - Dashboard</PageTitle>

<h1>ScanRev Global Admin</h1>

@if (_loading)
{
    <p><em>Loading dashboard...</em></p>
}
else if (_stats != null)
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Workspaces</h5>
                    <h2>@_stats.TotalWorkspaces</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <h2>@_stats.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Documents</h5>
                    <h2>@_stats.TotalDocuments.ToString("N0")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Database Size</h5>
                    <h2>@Analytics.FormatBytes(_stats.TotalDatabaseSizeBytes)</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Top Workspaces by Size</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Workspace</th>
                                <th>DB Size</th>
                                <th>Documents</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ws in _stats.TopWorkspacesBySize)
                            {
                                <tr>
                                    <td>@ws.WorkspaceName</td>
                                    <td>@Analytics.FormatBytes(ws.DatabaseSizeBytes)</td>
                                    <td>@ws.DocumentCount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Top Workspaces by Documents</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Workspace</th>
                                <th>Documents</th>
                                <th>Users</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ws in _stats.TopWorkspacesByDocuments)
                            {
                                <tr>
                                    <td>@ws.WorkspaceName</td>
                                    <td>@ws.DocumentCount.ToString("N0")</td>
                                    <td>@ws.UserCount / @ws.LicenseCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private GlobalStats? _stats;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _stats = await Analytics.GetGlobalStatsAsync();
        _loading = false;
    }
}
