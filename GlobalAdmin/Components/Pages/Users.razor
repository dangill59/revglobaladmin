@page "/users"
@using GlobalAdmin.Services
@using commonInterfaces.dbDataTypes
@inject UserService UserService
@rendermode InteractiveServer

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<div class="mb-3">
    <div class="input-group">
        <input type="text" class="form-control" placeholder="Search by email or name..."
               @bind="_searchTerm" />
        <button class="btn btn-primary" @onclick="Search">Search</button>
    </div>
</div>

<p class="text-muted">Total users: @_totalCount</p>

@if (_loading)
{
    <p><em>Loading users...</em></p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Email</th>
                <th>Name</th>
                <th>Username</th>
                <th>Created</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in _users)
            {
                <tr>
                    <td>@user.emailaddress</td>
                    <td>@user.preferredName</td>
                    <td><small class="text-muted">@user.UserName</small></td>
                    <td>@user.created?.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (user.isDisabled == true)
                        {
                            <span class="badge bg-danger">Disabled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        @if (user.isDisabled == true)
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => EnableUser(user.id)">Enable</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DisableUser(user.id)">Disable</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            <li class="page-item @(_page == 0 ? "disabled" : "")">
                <button class="page-link" @onclick="PreviousPage">Previous</button>
            </li>
            <li class="page-item">
                <span class="page-link">Page @(_page + 1)</span>
            </li>
            <li class="page-item @(_users.Count < _pageSize ? "disabled" : "")">
                <button class="page-link" @onclick="NextPage">Next</button>
            </li>
        </ul>
    </nav>
}

<hr />

<h3>Admin Users</h3>

<div class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="email" class="form-control" placeholder="Add admin email..."
               @bind="_newAdminEmail" />
        <button class="btn btn-success" @onclick="AddAdmin">Add Admin</button>
    </div>
</div>

<ul class="list-group" style="max-width: 400px;">
    @foreach (var admin in _adminUsers)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            @admin
            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAdmin(admin)">Remove</button>
        </li>
    }
</ul>

@code {
    private List<User> _users = new();
    private List<string> _adminUsers = new();
    private bool _loading = true;
    private string _searchTerm = "";
    private string _newAdminEmail = "";
    private int _page = 0;
    private int _pageSize = 50;
    private long _totalCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadAdmins();
        _totalCount = await UserService.GetTotalUserCountAsync();
    }

    private async Task LoadUsers()
    {
        _loading = true;

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _users = await UserService.GetAllUsersAsync(_page * _pageSize, _pageSize);
        }
        else
        {
            _users = await UserService.SearchUsersAsync(_searchTerm);
        }

        _loading = false;
    }

    private async Task LoadAdmins()
    {
        _adminUsers = await UserService.GetAdminUsersAsync();
    }

    private async Task Search()
    {
        _page = 0;
        await LoadUsers();
    }

    private async Task PreviousPage()
    {
        if (_page > 0)
        {
            _page--;
            await LoadUsers();
        }
    }

    private async Task NextPage()
    {
        _page++;
        await LoadUsers();
    }

    private async Task DisableUser(string userId)
    {
        await UserService.DisableUserAsync(userId);
        await LoadUsers();
    }

    private async Task EnableUser(string userId)
    {
        await UserService.EnableUserAsync(userId);
        await LoadUsers();
    }

    private async Task AddAdmin()
    {
        if (string.IsNullOrWhiteSpace(_newAdminEmail)) return;

        await UserService.AddAdminUserAsync(_newAdminEmail);
        _newAdminEmail = "";
        await LoadAdmins();
    }

    private async Task RemoveAdmin(string email)
    {
        await UserService.RemoveAdminUserAsync(email);
        await LoadAdmins();
    }
}
