@page "/users"
@using GlobalAdmin.Services
@using MongoDB.Bson
@inject UserService UserService
@rendermode InteractiveServer

<PageTitle>Admin Access</PageTitle>

<h1>Admin Access</h1>
<p class="text-muted">Manage who can access the GlobalAdmin portal</p>

<div class="card" style="max-width: 500px;">
    <div class="card-header">
        <h5 class="mb-0">Add Admin User</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }
        <div class="input-group">
            <input type="email" class="form-control" placeholder="Email address..."
                   @bind="_newAdminEmail" @onkeyup="HandleKeyUp" />
            <button class="btn btn-success" @onclick="AddAdmin" disabled="@_adding">
                @if (_adding)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Add
            </button>
        </div>
    </div>
</div>

<div class="card mt-4" style="max-width: 500px;">
    <div class="card-header">
        <h5 class="mb-0">Current Admins (@_adminUsers.Count)</h5>
    </div>
    <ul class="list-group list-group-flush">
        @if (_loading)
        {
            <li class="list-group-item"><em>Loading...</em></li>
        }
        else if (_adminUsers.Count == 0)
        {
            <li class="list-group-item text-muted">No admin users configured</li>
        }
        else
        {
            @foreach (var admin in _adminUsers)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@admin</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAdmin(admin)">
                        Remove
                    </button>
                </li>
            }
        }
    </ul>
</div>

@code {
    private List<string> _adminUsers = new();
    private bool _loading = true;
    private bool _adding = false;
    private string _newAdminEmail = "";
    private string _errorMessage = "";
    private string _successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAdmins();
    }

    private async Task LoadAdmins()
    {
        _loading = true;
        _adminUsers = await UserService.GetAdminUsersAsync();
        _loading = false;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddAdmin();
        }
    }

    private async Task AddAdmin()
    {
        if (string.IsNullOrWhiteSpace(_newAdminEmail)) return;

        _adding = true;
        _errorMessage = "";
        _successMessage = "";

        try
        {
            await UserService.AddAdminUserAsync(_newAdminEmail.Trim().ToLower());
            _successMessage = $"Added {_newAdminEmail} as admin";
            _newAdminEmail = "";
            await LoadAdmins();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task RemoveAdmin(string email)
    {
        _errorMessage = "";
        _successMessage = "";

        try
        {
            await UserService.RemoveAdminUserAsync(email);
            _successMessage = $"Removed {email} from admins";
            await LoadAdmins();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
