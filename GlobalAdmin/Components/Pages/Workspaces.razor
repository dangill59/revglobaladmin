@page "/workspaces"
@using GlobalAdmin.Services
@using MongoDB.Bson
@inject WorkspaceService WorkspaceService
@inject AnalyticsService Analytics
@rendermode InteractiveServer

<PageTitle>Workspaces</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Workspaces</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        + Create Workspace
    </button>
</div>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Search workspaces..."
           @bind="_searchTerm" @bind:event="oninput" />
</div>

@if (_loading)
{
    <p><em>Loading workspaces...</em></p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Owner</th>
                <th>Users</th>
                <th>Licenses</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ws in _workspaces)
            {
                var id = WorkspaceService.GetId(ws);
                var name = WorkspaceService.GetString(ws, "name");
                var owner = WorkspaceService.GetString(ws, "ownerUser");
                var maxUsers = WorkspaceService.GetInt(ws, "maxUsers", 5);
                var isDisabled = WorkspaceService.GetBool(ws, "isDisabled");
                <tr>
                    <td>@name</td>
                    <td>@owner</td>
                    <td>0</td>
                    <td>
                        <span class="badge bg-info">@maxUsers</span>
                    </td>
                    <td>
                        @if (isDisabled)
                        {
                            <span class="badge bg-danger">Disabled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            @if (isDisabled)
                            {
                                <button class="btn btn-outline-success" @onclick="() => EnableWorkspace(id)">Enable</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-danger" @onclick="() => DisableWorkspace(id)">Disable</button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<BsonDocument> _workspaces = new();
    private bool _loading = true;
    private string _searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaces();
    }

    private async Task LoadWorkspaces()
    {
        _loading = true;
        _workspaces = await WorkspaceService.GetAllWorkspacesAsync();
        _loading = false;
    }

    private void ShowCreateModal()
    {
    }

    private async Task DisableWorkspace(string id)
    {
        await WorkspaceService.DisableWorkspaceAsync(id);
        await LoadWorkspaces();
    }

    private async Task EnableWorkspace(string id)
    {
        await WorkspaceService.EnableWorkspaceAsync(id);
        await LoadWorkspaces();
    }
}
