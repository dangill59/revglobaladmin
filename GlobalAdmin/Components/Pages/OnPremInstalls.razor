@page "/onprem"
@using GlobalAdmin.Models
@using GlobalAdmin.Services
@inject OnPremService OnPremService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>On-Prem Installations</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>On-Prem Installations</h1>
    <button class="btn btn-primary" @onclick="ShowGenerateKeyModal">
        + Generate Registration Key
    </button>
</div>

@* Summary Cards *@
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h3 class="card-title">@_summary.HealthyCount</h3>
                <p class="card-text mb-0">Healthy</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-dark bg-warning">
            <div class="card-body">
                <h3 class="card-title">@_summary.WarningCount</h3>
                <p class="card-text mb-0">Needs Attention</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h3 class="card-title">@_summary.OfflineCount</h3>
                <p class="card-text mb-0">Offline</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h3 class="card-title">@_summary.TotalDocuments.ToString("N0")</h3>
                <p class="card-text mb-0">Total Documents</p>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Search installations..."
           @bind="_searchTerm" @bind:event="oninput" />
</div>

@if (_loading)
{
    <p><em>Loading installations...</em></p>
}
else if (!_installs.Any())
{
    <div class="alert alert-info">
        <h5>No On-Prem Installations</h5>
        <p class="mb-0">Generate a registration key and provide it to the customer to register their on-prem installation.</p>
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Version</th>
                <th>Users</th>
                <th>Documents</th>
                <th>Storage</th>
                <th>Last Seen</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var install in FilteredInstalls)
            {
                <tr class="@GetRowClass(install.Status)">
                    <td>
                        <a href="/onprem/@install.Id"><strong>@install.CustomerName</strong></a><br />
                        <small class="text-muted">@install.ContactEmail</small>
                    </td>
                    <td>
                        @install.Version
                        @if (!string.IsNullOrEmpty(_latestVersion) && install.Version != _latestVersion)
                        {
                            <br /><span class="badge bg-warning text-dark">Update Available</span>
                        }
                    </td>
                    <td>@(install.Metrics?.ActiveUsers ?? 0) / @(install.License?.MaxUsers ?? 0)</td>
                    <td>@((install.Metrics?.DocumentCount ?? 0).ToString("N0"))</td>
                    <td>@((install.Metrics?.StorageUsedGB ?? 0).ToString("F1")) GB</td>
                    <td>@FormatLastSeen(install.LastHeartbeat)</td>
                    <td>
                        @switch (install.Status)
                        {
                            case "healthy":
                                <span class="badge bg-success">Healthy</span>
                                break;
                            case "warning":
                                <span class="badge bg-warning text-dark">Warning</span>
                                break;
                            case "offline":
                                <span class="badge bg-danger">Offline</span>
                                break;
                            default:
                                <span class="badge bg-secondary">Unknown</span>
                                break;
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="@(() => Nav.NavigateTo($"/onprem/{install.Id}"))">
                            Details
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Unused Registration Keys *@
@if (_unusedKeys.Any())
{
    <h4 class="mt-4">Unused Registration Keys</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Key</th>
                <th>Customer</th>
                <th>Tier</th>
                <th>Max Users</th>
                <th>Expires</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var key in _unusedKeys)
            {
                <tr>
                    <td><code>@key.Key</code></td>
                    <td>@key.CustomerName</td>
                    <td><span class="badge bg-info">@key.Tier</span></td>
                    <td>@key.MaxUsers</td>
                    <td>@(key.ExpiresAt?.ToString("MMM dd, yyyy") ?? "Never")</td>
                </tr>
            }
        </tbody>
    </table>
}

@* Generate Key Modal *@
@if (_showGenerateKeyModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generate Registration Key</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger">@_errorMessage</div>
                    }
                    @if (_generatedKey != null)
                    {
                        <div class="alert alert-success">
                            <h6>Registration Key Generated!</h6>
                            <p class="mb-2">Provide this key to the customer:</p>
                            <code class="fs-5">@_generatedKey.Key</code>
                            <hr />
                            <small>This key expires on @_generatedKey.ExpiresAt?.ToString("MMMM dd, yyyy")</small>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Customer Name</label>
                            <input type="text" class="form-control" @bind="_keyCustomerName" placeholder="e.g. Acme Corporation" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contact Email</label>
                            <input type="email" class="form-control" @bind="_keyContactEmail" placeholder="it@acme.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Max Users (Licenses)</label>
                            <input type="number" class="form-control" @bind="_keyMaxUsers" min="1" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tier</label>
                            <select class="form-select" @bind="_keyTier">
                                <option value="standard">Standard</option>
                                <option value="professional">Professional</option>
                                <option value="enterprise">Enterprise</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Valid For (Days)</label>
                            <input type="number" class="form-control" @bind="_keyValidDays" min="1" max="365" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                        @(_generatedKey != null ? "Close" : "Cancel")
                    </button>
                    @if (_generatedKey == null)
                    {
                        <button type="button" class="btn btn-primary" @onclick="GenerateKey" disabled="@_generating">
                            @if (_generating)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Generate Key
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<OnPremInstall> _installs = new();
    private List<RegistrationKey> _unusedKeys = new();
    private OnPremSummary _summary = new();
    private bool _loading = true;
    private string _searchTerm = "";
    private string _latestVersion = "3.6.3";

    // Generate key modal
    private bool _showGenerateKeyModal = false;
    private bool _generating = false;
    private string _keyCustomerName = "";
    private string _keyContactEmail = "";
    private int _keyMaxUsers = 10;
    private string _keyTier = "standard";
    private int _keyValidDays = 30;
    private string _errorMessage = "";
    private RegistrationKey? _generatedKey = null;

    private IEnumerable<OnPremInstall> FilteredInstalls => string.IsNullOrWhiteSpace(_searchTerm)
        ? _installs
        : _installs.Where(i =>
            i.CustomerName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
            i.ContactEmail.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _installs = await OnPremService.GetAllInstallsAsync();
        _unusedKeys = await OnPremService.GetUnusedRegistrationKeysAsync();
        _summary = await OnPremService.GetSummaryAsync(_latestVersion);
        _loading = false;
    }

    private void ShowGenerateKeyModal()
    {
        _keyCustomerName = "";
        _keyContactEmail = "";
        _keyMaxUsers = 10;
        _keyTier = "standard";
        _keyValidDays = 30;
        _errorMessage = "";
        _generatedKey = null;
        _showGenerateKeyModal = true;
    }

    private void CloseModal()
    {
        _showGenerateKeyModal = false;
        _errorMessage = "";
        _generatedKey = null;
        _ = LoadData();
    }

    private async Task GenerateKey()
    {
        if (string.IsNullOrWhiteSpace(_keyCustomerName) || string.IsNullOrWhiteSpace(_keyContactEmail))
        {
            _errorMessage = "Customer name and contact email are required";
            return;
        }

        _generating = true;
        _errorMessage = "";

        try
        {
            _generatedKey = await OnPremService.GenerateRegistrationKeyAsync(
                _keyCustomerName,
                _keyContactEmail,
                _keyMaxUsers,
                _keyTier,
                _keyValidDays);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _generating = false;
        }
    }

    private string GetRowClass(string status) => status switch
    {
        "warning" => "table-warning",
        "offline" => "table-danger",
        _ => ""
    };

    private string FormatLastSeen(DateTime dt)
    {
        if (dt == DateTime.MinValue) return "Never";

        var ago = DateTime.UtcNow - dt;
        if (ago.TotalMinutes < 1) return "Just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        if (ago.TotalDays < 30) return $"{(int)ago.TotalDays}d ago";
        return dt.ToString("MMM dd, yyyy");
    }
}
