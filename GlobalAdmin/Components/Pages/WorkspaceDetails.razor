@page "/workspaces/{WorkspaceId}"
@using GlobalAdmin.Services
@using MongoDB.Bson
@inject WorkspaceService WorkspaceService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>@(_workspaceName ?? "Workspace Details")</PageTitle>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/workspaces">Workspaces</a></li>
        <li class="breadcrumb-item active">@(_workspaceName ?? "Loading...")</li>
    </ol>
</nav>

@if (_loading)
{
    <p><em>Loading workspace details...</em></p>
}
else if (_workspace == null)
{
    <div class="alert alert-danger">Workspace not found.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>@_workspaceName</h1>
            <p class="text-muted mb-0">Owner: @_ownerEmail</p>
        </div>
        <div>
            @if (_isDisabled)
            {
                <span class="badge bg-danger fs-6">Disabled</span>
            }
            else
            {
                <span class="badge bg-success fs-6">Active</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageSuccess ? "alert-success" : "alert-danger") alert-dismissible">
            @_message
            <button type="button" class="btn-close" @onclick="@(() => _message = string.Empty)"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <!-- Soft Delete Card -->
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Soft Delete</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" @bind="_softDeleteEnabled" id="softDeleteEnabled" />
                        <label class="form-check-label" for="softDeleteEnabled">@(_softDeleteEnabled ? "Enabled" : "Disabled")</label>
                    </div>
                </div>
                <div class="card-body @(_softDeleteEnabled ? "" : "text-muted")">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Retention Days</label>
                            <input type="number" class="form-control" @bind="_softDeleteRetentionDays" min="1" max="365" disabled="@(!_softDeleteEnabled)" />
                            <small class="text-muted">Days before auto-purge</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" @bind="_softDeleteAutoDelete" id="autoDelete" disabled="@(!_softDeleteEnabled)" />
                                <label class="form-check-label" for="autoDelete">Auto-purge after retention period</label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_softDeleteRequireReason" id="requireReason" disabled="@(!_softDeleteEnabled)" />
                                <label class="form-check-label" for="requireReason">Require deletion reason</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_softDeleteNotifyOnPurge" id="notifyPurge" disabled="@(!_softDeleteEnabled)" />
                                <label class="form-check-label" for="notifyPurge">Notify admins on purge</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Billable Features Card -->
            <div class="card mb-3">
                <div class="card-header">Billable Features</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="_featureFullTextOcr" id="fullTextOcr" />
                                <label class="form-check-label" for="fullTextOcr">Full-Text OCR</label>
                            </div>
                            <small class="text-muted">Enable full document text extraction</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="_featureBarcode" id="barcode" />
                                <label class="form-check-label" for="barcode">Barcode Detection</label>
                            </div>
                            <small class="text-muted">Enable barcode/QR code scanning</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="_featureScripts" id="scripts" />
                                <label class="form-check-label" for="scripts">Scripting</label>
                            </div>
                            <small class="text-muted">Enable custom scripts/automation</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="_featureTwoFactor" id="twoFactor" />
                                <label class="form-check-label" for="twoFactor">Two-Factor Auth</label>
                            </div>
                            <small class="text-muted">Enable 2FA for users</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- OCR Settings Card -->
            <div class="card mb-3">
                <div class="card-header">OCR Settings</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">OCR Engine</label>
                            <select class="form-select" @bind="_ocrEngine">
                                <option value="tess">Tesseract (Local)</option>
                                <option value="google">Google Vision</option>
                                <option value="hybrid">Hybrid (Tesseract + Google)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Google OCR Quota (pages/month)</label>
                            <input type="number" class="form-control" @bind="_googleOcrQuota" min="0" />
                            <small class="text-muted">0 = unlimited</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Session & Activity Card -->
            <div class="card mb-3">
                <div class="card-header">Session & Activity</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Inactivity Timeout (minutes)</label>
                            <input type="number" class="form-control" @bind="_inactivityTimeout" min="5" max="480" />
                            <small class="text-muted">Session expires after inactivity</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Activity Log Retention</label>
                            <select class="form-select" @bind="_activityRetentionHours">
                                <option value="1">1 hour</option>
                                <option value="6">6 hours</option>
                                <option value="12">12 hours</option>
                                <option value="24">24 hours (default)</option>
                                <option value="48">48 hours</option>
                                <option value="168">7 days</option>
                                <option value="-1">Keep indefinitely</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Processing Settings Card -->
            <div class="card mb-3">
                <div class="card-header">Processing Settings</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Max Immediate Processing (pages)</label>
                            <input type="number" class="form-control" @bind="_maxImmediateSize" min="1" max="100" />
                            <small class="text-muted">Larger jobs queued for background</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" @bind="_suspendProcessing" id="suspendProcessing" />
                                <label class="form-check-label" for="suspendProcessing">Suspend Background Processing</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Workspace Info Card -->
            <div class="card mb-3">
                <div class="card-header">Workspace Info</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tr><th>ID</th><td><code style="font-size: 0.7rem;">@WorkspaceId</code></td></tr>
                        <tr><th>Name</th><td>@_workspaceName</td></tr>
                        <tr><th>Owner</th><td>@_ownerEmail</td></tr>
                        <tr><th>Max Users</th><td>@_maxUsers</td></tr>
                    </table>
                </div>
            </div>

            <!-- Save Button -->
            <div class="card mb-3">
                <div class="card-body">
                    <button class="btn btn-primary w-100" @onclick="SaveChanges" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Save All Changes
                    </button>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card mb-3">
                <div class="card-header">Quick Actions</div>
                <div class="card-body d-grid gap-2">
                    @if (_isDisabled)
                    {
                        <button class="btn btn-outline-success" @onclick="EnableWorkspace">Enable Workspace</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-danger" @onclick="DisableWorkspace">Disable Workspace</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string WorkspaceId { get; set; } = "";

    private BsonDocument? _workspace;
    private bool _loading = true;
    private bool _saving = false;
    private string _message = "";
    private bool _messageSuccess = false;

    private string _workspaceName = "";
    private string _ownerEmail = "";
    private int _maxUsers = 5;
    private bool _isDisabled = false;

    // Soft Delete
    private bool _softDeleteEnabled = false;
    private int _softDeleteRetentionDays = 30;
    private bool _softDeleteAutoDelete = true;
    private bool _softDeleteRequireReason = false;
    private bool _softDeleteNotifyOnPurge = false;

    // Features
    private bool _featureFullTextOcr = false;
    private bool _featureBarcode = false;
    private bool _featureScripts = false;
    private bool _featureTwoFactor = false;

    // OCR
    private string _ocrEngine = "tess";
    private int _googleOcrQuota = 0;

    // Session
    private int _inactivityTimeout = 15;
    private int _activityRetentionHours = 24;

    // Processing
    private int _maxImmediateSize = 10;
    private bool _suspendProcessing = false;

    protected override async Task OnInitializedAsync() => await LoadWorkspace();

    private async Task LoadWorkspace()
    {
        _loading = true;
        _workspace = await WorkspaceService.GetWorkspaceByIdAsync(WorkspaceId);

        if (_workspace != null)
        {
            _workspaceName = WorkspaceService.GetString(_workspace, "name");
            _ownerEmail = WorkspaceService.GetString(_workspace, "ownerUser");
            _maxUsers = WorkspaceService.GetInt(_workspace, "maxUsers", 5);
            _isDisabled = WorkspaceService.GetBool(_workspace, "isDisabled");

            // Soft Delete
            if (_workspace.Contains("softDeleteConfig") && !_workspace["softDeleteConfig"].IsBsonNull)
            {
                var sd = _workspace["softDeleteConfig"].AsBsonDocument;
                _softDeleteEnabled = GetBool(sd, "enabled", false);
                _softDeleteRetentionDays = GetInt(sd, "retentionDays", 30);
                _softDeleteAutoDelete = GetBool(sd, "autoDeleteEnabled", true);
                _softDeleteRequireReason = GetBool(sd, "requireReasonOnDelete", false);
                _softDeleteNotifyOnPurge = GetBool(sd, "notifyOnPurge", false);
            }

            // Features
            if (_workspace.Contains("features") && !_workspace["features"].IsBsonNull)
            {
                var f = _workspace["features"].AsBsonDocument;
                _featureFullTextOcr = HasFeature(f, "fullTextOCR");
                _featureBarcode = HasFeature(f, "barcode");
                _featureScripts = HasFeature(f, "scripts");
                _featureTwoFactor = HasFeature(f, "twofactorAuth");
                if (f.Contains("fullTextOCR") && !f["fullTextOCR"].IsBsonNull)
                {
                    var ft = f["fullTextOCR"].AsBsonDocument;
                    if (ft.Contains("config") && !ft["config"].IsBsonNull)
                        _ocrEngine = GetString(ft["config"].AsBsonDocument, "ocrEngine", "tess");
                }
            }

            // Quotas
            if (_workspace.Contains("quotas") && !_workspace["quotas"].IsBsonNull)
            {
                var q = _workspace["quotas"].AsBsonDocument;
                if (q.Contains("googleOCR") && !q["googleOCR"].IsBsonNull)
                    _googleOcrQuota = GetInt(q["googleOCR"].AsBsonDocument, "limit", 0);
            }

            _inactivityTimeout = GetInt(_workspace, "inactivityTimeoutMin", 15);
            _activityRetentionHours = GetInt(_workspace, "activityRetentionHours", 24);
            _maxImmediateSize = GetInt(_workspace, "maxImmediatePageProcessingSize", 10);
            _suspendProcessing = WorkspaceService.GetBool(_workspace, "suspendBackGroundImageProcessing");
        }
        _loading = false;
    }

    private async Task SaveChanges()
    {
        _saving = true;
        _message = "";
        try
        {
            await WorkspaceService.UpdateWorkspaceSettingsAsync(WorkspaceId, new WorkspaceSettings
            {
                SoftDeleteEnabled = _softDeleteEnabled,
                SoftDeleteRetentionDays = _softDeleteRetentionDays,
                SoftDeleteAutoDelete = _softDeleteAutoDelete,
                SoftDeleteRequireReason = _softDeleteRequireReason,
                SoftDeleteNotifyOnPurge = _softDeleteNotifyOnPurge,
                FeatureFullTextOcr = _featureFullTextOcr,
                FeatureBarcode = _featureBarcode,
                FeatureScripts = _featureScripts,
                FeatureTwoFactor = _featureTwoFactor,
                OcrEngine = _ocrEngine,
                GoogleOcrQuota = _googleOcrQuota,
                InactivityTimeout = _inactivityTimeout,
                ActivityRetentionHours = _activityRetentionHours,
                MaxImmediateSize = _maxImmediateSize,
                SuspendProcessing = _suspendProcessing
            });
            _message = "Settings saved successfully.";
            _messageSuccess = true;
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
            _messageSuccess = false;
        }
        finally { _saving = false; }
    }

    private async Task DisableWorkspace()
    {
        await WorkspaceService.DisableWorkspaceAsync(WorkspaceId);
        _isDisabled = true;
        _message = "Workspace disabled.";
        _messageSuccess = true;
    }

    private async Task EnableWorkspace()
    {
        await WorkspaceService.EnableWorkspaceAsync(WorkspaceId);
        _isDisabled = false;
        _message = "Workspace enabled.";
        _messageSuccess = true;
    }

    private bool HasFeature(BsonDocument f, string name) =>
        f.Contains(name) && !f[name].IsBsonNull && GetInt(f[name].AsBsonDocument, "count", 0) > 0;

    private static string GetString(BsonDocument d, string f, string def = "") =>
        d.Contains(f) && !d[f].IsBsonNull ? d[f].AsString : def;

    private static int GetInt(BsonDocument d, string f, int def = 0)
    {
        if (!d.Contains(f) || d[f].IsBsonNull) return def;
        if (d[f].IsInt32) return d[f].AsInt32;
        if (d[f].IsInt64) return (int)d[f].AsInt64;
        return def;
    }

    private static bool GetBool(BsonDocument d, string f, bool def = false) =>
        d.Contains(f) && !d[f].IsBsonNull ? d[f].AsBoolean : def;
}
